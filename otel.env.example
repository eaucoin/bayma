# Development telemetry: where bayma's development, its scripts,
# provisioning, builds, and test runs, sends OpenTelemetry traces, metrics,
# and logs. Copy this file to otel.env, which git ignores and every
# `bun run` script loads, and fill in what your backend needs; a variable set
# in your shell takes precedence. A variable left empty is unset; with all of
# them empty, nothing is exported. tooling/src/telemetry/config.ts describes
# these and the rest of the variables OpenTelemetry's SDK reads.

# Where to send every signal, over OTLP.
OTEL_EXPORTER_OTLP_ENDPOINT=
# grpc, http/protobuf, or http/json.
OTEL_EXPORTER_OTLP_PROTOCOL=
# Headers for every request, such as authentication: key=value,key=value.
OTEL_EXPORTER_OTLP_HEADERS=

# Or somewhere for each signal of its own. A signal with nothing set for it,
# here or above, is not exported.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_HEADERS=
