{
  "name": "bayma-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tooling"
  ],
  "scripts": {
    "build": "bun tooling/src/cli.ts build",
    "provision": "bun tooling/src/cli.ts provision",
    "payload": "bun tooling/src/cli.ts payload",
    "release": "bun tooling/src/cli.ts release",
    "pack": "bun tooling/src/cli.ts pack",
    "test": "bun tooling/src/cli.ts test tests/unit tests/integration tests/tooling",
    "test:e2e": "bun tooling/src/cli.ts test tests/e2e",
    "typecheck": "bun tooling/src/cli.ts typecheck",
    "format": "bun tooling/src/cli.ts format",
    "format:check": "bun tooling/src/cli.ts format --check"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@bayma-repl/bayma": "workspace:*",
    "@bayma/core": "workspace:*",
    "@bayma/runtime-bun": "workspace:*",
    "@bayma/runtime-dotnet-script": "workspace:*",
    "@bayma/runtime-python": "workspace:*",
    "@bayma/runtime-rust": "workspace:*",
    "@bayma/runtime-cpp": "workspace:*",
    "@bayma/tooling": "workspace:*",
    "@types/node": "26.6.2",
    "bun-types": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
